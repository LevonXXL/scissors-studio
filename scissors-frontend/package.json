{
  "name": "Scissors",
  "version": "0.0.1",
  "description": "Scissors Studio",
  "productName": "Scissors Studio",
  "author": "Scissors Studio",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "test:messenger-links": "node --experimental-strip-types --test tests/feedbackMessenger.test.mjs",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@quasar/extras": "^2.0.0",
    "axios": "^1.18.1",
    "pinia": "^4.0.2",
    "quasar": "^2.23.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.2.0",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.12.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
